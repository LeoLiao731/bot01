				$('.eIBXfJ a, .ad-body a,.position_fix_top a,a.video_link_qc,a.video_link_toy').each(function () {
					var url = $(this).attr('href');
					var from_param = '';
					//情品站
					if (url.indexOf("from=") > -1) {
						from_param = getUrlParameter('from',url);
						from_param = from_param!=='{pos}'?from_param:'';
						from_param=from_param?(from_param+'-'+comesite):comesite;
						url = addUrlParam(url,'from',from_param);
					}else{
						//其他站
						from_param = getUrlParameter('fromsite',url);
						//若有fromsite參數則放進去，沒有則放到子網域
						if(from_param!=='') {
							from_param=comesite+'.'+from_param;
							url = addUrlParam(url, 'fromsite', from_param);
						}else if ( allow_comesites( url)) {
							var url_array = url.split('/');
							url='';
							url_array.forEach(function (element,index) {
								if(index===2){
									url+=comesite+'.'+element+'/';
								}else{
									url+=element+'/';
								}
							})

						}
					}
					$(this).attr('href',url);
				});

			}

			/** comesite推廣 **/
			function allow_comesites( url) {
				var retFlag = false ;
				var allow_comesites = ['iqqtv.net','iqqtv.cloud','bdsmtv.cc','bdsmtv.me'] ;

				for( i=0; i < allow_comesites.length; i++){
					// console.log(allow_comesites[i]) ;
					if  ( url.indexOf(allow_comesites[i]) > 0) {
						retFlag = true ;
					}
				}
				return retFlag ;
			}

			function getUrlParameter(name,url=null) {
				name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
				var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
				var results = regex.exec(url!==null?url:location.href);
				return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
			}
			function addUrlParam (search, key, val) {
				var newParam = key + '=' + val,
						params = '?' + newParam;

				// If the "search" string exists, then build params from it
				if (search) {

					// Try to replace an existance instance
					params = search.replace(new RegExp('([?&])' + key + '[^&]*'), '$1' + newParam);
					// If nothing was replaced, then add the new param to the end
					if (params === search) {
						var search_array= search.split('/');
						//只有網域
						if(search_array.length===3){
							params += '/?' + newParam;
						}else {
							params += '&' + newParam;
						}
					}
				}

				return params;
			}
		});

